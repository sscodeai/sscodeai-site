---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog | SSCodeAI"
  description="SSCodeAI の技術ブログ、開発ログ、AI agent workflow tutorial。"
>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto w-full max-w-3xl px-6 py-16">
      <h1 class="text-foreground" style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);">Blog</h1>
      <p class="mt-2 text-muted-foreground">SSCodeAI の技術ブログ、開発ログ、AI agent workflow tutorial。</p>
      <ul class="mt-8 grid grid-cols-1 gap-3">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="block rounded-lg border border-border p-4 no-underline transition-colors hover:border-border-strong"
              >
                <div class="font-medium text-foreground">{post.data.title}</div>
                <div class="mt-1 text-sm text-muted-foreground">{post.data.description}</div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</BaseLayout>
